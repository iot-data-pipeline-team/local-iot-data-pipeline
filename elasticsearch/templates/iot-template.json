{
  "index_patterns": ["iot-*"],
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0
    },
    "mappings": {
      "properties": {
        "device_id": {
          "type": "keyword"
        },
        "device_type": {
          "type": "keyword"
        },
        "location": {
          "type": "keyword"
        },
        "technician": {
          "type": "keyword"
        },
        "temperature": {
          "type": "float"
        },
        "humidity": {
          "type": "float"
        },
        "status": {
          "type": "keyword"
        },
        "anomaly_flag": {
          "type": "integer"
        },
        "timestamp": {
          "type": "date"
        }
      }
    }
  }
}